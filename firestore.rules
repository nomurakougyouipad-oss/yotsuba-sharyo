rules_version = '2';

// 社用車管理アプリ（yotsuba-sharyo）Firestore ルール
// - アプリを開いた人（匿名ログイン済み）だけが読み書きできる
// - 決まった形のデータしか保存できない
// - 車・予約・修理は消せない（廃車は retired: true で残す）。サンプルデータ（sample: true）だけは消せる
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function str(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function optStr(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }
    function isSample() {
      return resource.data.get('sample', false) == true;
    }
    // サンプルの車に付いている予約・修理（試しに使ったときの記録）も消せるようにする
    function onSampleVehicle() {
      let path = /databases/$(database)/documents/vehicles/$(resource.data.vehicleId);
      return exists(path) && get(path).data.get('sample', false) == true;
    }

    // ---- 車両 ----
    function validVehicle(d) {
      return d.keys().hasAll(['plateArea', 'plateClass', 'plateKana', 'plateNum', 'kind', 'type', 'shakenDate', 'homeLot', 'retired'])
        && str(d.plateArea, 10)
        && str(d.plateClass, 3)
        && str(d.plateKana, 2)
        && str(d.plateNum, 10)
        && str(d.kind, 60)
        && d.type in ['トラック', 'バン', '普通車']
        && isDate(d.shakenDate)
        && str(d.homeLot, 30)
        && optStr(d, 'currentLot', 30)
        && optStr(d, 'photoUrl', 2000)
        && (!('status' in d) || d.status in ['free', 'use', 'fix'])
        && d.retired is bool;
    }
    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validVehicle(request.resource.data);
      allow delete: if signedIn() && isSample();
    }

    // ---- 予約 ----
    function validReservation(d) {
      return d.keys().hasAll(['vehicleId', 'who', 'site', 'from', 'to'])
        && str(d.vehicleId, 100)
        && str(d.who, 40)
        && str(d.site, 100)
        && isDate(d.from) && isDate(d.to) && d.from <= d.to
        && optStr(d, 'createdBy', 40)
        && optStr(d, 'returnedLot', 30);
    }
    match /reservations/{reservationId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validReservation(request.resource.data);
      allow delete: if signedIn() && (isSample() || onSampleVehicle());
    }

    // ---- 修理依頼 ----
    function validRepair(d) {
      return d.keys().hasAll(['vehicleId', 'status'])
        && str(d.vehicleId, 100)
        && d.status in ['open', 'in_repair', 'done']
        && (!('symptoms' in d) || (d.symptoms is list && d.symptoms.size() <= 20))
        && optStr(d, 'memo', 2000)
        && (!('photoUrls' in d) || (d.photoUrls is list && d.photoUrls.size() <= 20))
        && optStr(d, 'reportedBy', 40);
    }
    match /repairs/{repairId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validRepair(request.resource.data);
      allow delete: if signedIn() && (isSample() || onSampleVehicle());
    }

    // ---- 名簿（日報アプリと同じ形：名前・区分・所属・表示するか） ----
    function validMember(d) {
      return d.keys().hasAll(['name', 'kubun', 'active'])
        && str(d.name, 30)
        && d.kubun in ['自社', '常駐協力', '外注協力']
        && optStr(d, 'shozoku', 30)
        && d.active is bool;
    }
    match /members/{memberId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validMember(request.resource.data);
      // 消さない（隠すだけ。予約・修理の記録は名前で残る）
    }

    // ---- 設定（現場・駐車場のリスト、車検通知の日数など） ----
    function validSettings(d) {
      return (!('people' in d) || (d.people is list && d.people.size() <= 200))
        && (!('sites' in d) || (d.sites is list && d.sites.size() <= 300))
        && (!('lots' in d) || (d.lots is list && d.lots.size() >= 1 && d.lots.size() <= 5))
        && (!('shakenAlertDays' in d) || (d.shakenAlertDays is int && d.shakenAlertDays >= 1 && d.shakenAlertDays <= 365));
    }
    match /settings/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && docId == 'app' && validSettings(request.resource.data);
    }

    // それ以外はすべて禁止
  }
}
